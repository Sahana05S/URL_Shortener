{
  "name": "linkora-url-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "eslint .",
    "test": "npm run test -w client && npm run test -w server",
    "check": "npm run lint && npm run test && npm run build",
    "security:check": "npm audit --audit-level=high && npm run test -w server",
    "test:e2e": "playwright test",
    "evidence:capture": "node scripts/capture-evidence.js",
    "db:generate": "npm run prisma:generate -w server",
    "db:migrate": "npm run prisma:migrate -w server",
    "db:deploy": "npm run prisma:deploy -w server",
    "db:seed": "npm run prisma:seed -w server",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "@playwright/test": "^1.55.1",
    "prettier": "^3.5.3"
  }
}
